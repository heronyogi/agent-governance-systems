{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heronyogi/agent-governance-systems/blob/main/schemas/system-registry.v0.1.schema.json",
  "title": "Federated agent system registry v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "contract_version", "systems"],
  "properties": {
    "catalog_version": {
      "const": "0.1.0"
    },
    "contract_version": {
      "const": "0.1.0"
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "system_id",
          "repository_url",
          "catalog_manifest",
          "source_manifest",
          "adoption"
        ],
        "properties": {
          "system_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "repository_url": {
            "type": "string",
            "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "catalog_manifest": {
            "type": "string",
            "pattern": "^manifests/[^/]+\\.json$"
          },
          "source_manifest": {
            "type": "string",
            "pattern": "^[^/].*\\.json$"
          },
          "adoption": {
            "enum": ["candidate", "active", "deprecated", "retired"]
          },
          "activation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_commit",
              "source_manifest_sha256",
              "post_merge_check",
              "activated_on"
            ],
            "properties": {
              "source_commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "source_manifest_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "post_merge_check": {
                "type": "string",
                "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/actions/runs/[0-9]+$"
              },
              "activated_on": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "adoption": {
                  "const": "candidate"
                }
              },
              "required": ["adoption"]
            },
            "then": {
              "not": {
                "required": ["activation"]
              }
            },
            "else": {
              "required": ["activation"]
            }
          }
        ]
      }
    }
  }
}
