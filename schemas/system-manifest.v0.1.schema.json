{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heronyogi/agent-governance-systems/blob/main/schemas/system-manifest.v0.1.schema.json",
  "title": "Federated agent system manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema",
    "contract_version",
    "system_id",
    "name",
    "repository_role",
    "repository",
    "lifecycle",
    "boundary",
    "interfaces",
    "relationships",
    "dependencies",
    "claim_boundary",
    "ip_boundary"
  ],
  "properties": {
    "manifest_schema": {
      "const": "https://raw.githubusercontent.com/heronyogi/agent-governance-systems/main/schemas/system-manifest.v0.1.schema.json"
    },
    "contract_version": {
      "const": "0.1.0"
    },
    "system_id": {
      "$ref": "#/$defs/systemId"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "repository_role": {
      "enum": [
        "system-root",
        "protocol",
        "reference",
        "adapters",
        "development-cases",
        "sealed-cases",
        "results"
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "default_branch", "manifest_path"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        },
        "manifest_path": {
          "type": "string",
          "pattern": "^[^/].*\\.json$"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "system_version", "stable_version"],
      "properties": {
        "state": {
          "enum": ["draft", "reference", "active", "deprecated", "retired"]
        },
        "system_version": {
          "type": "string",
          "minLength": 1
        },
        "stable_version": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["governing_question", "primary_invariant", "in_scope", "out_of_scope"],
      "properties": {
        "governing_question": {
          "type": "string",
          "minLength": 1
        },
        "primary_invariant": {
          "type": "string",
          "minLength": 1
        },
        "in_scope": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "out_of_scope": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      }
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provides", "consumes"],
      "properties": {
        "provides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interface"
          }
        },
        "consumes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interface"
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system_id", "kind", "required"],
        "properties": {
          "system_id": {
            "$ref": "#/$defs/systemId"
          },
          "kind": {
            "enum": ["sibling", "producer", "consumer", "shared-evaluation"]
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_systems", "evaluation_systems"],
      "properties": {
        "runtime_systems": {
          "$ref": "#/$defs/systemIds"
        },
        "evaluation_systems": {
          "$ref": "#/$defs/systemIds"
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims", "does_not_claim"],
      "properties": {
        "claims": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "does_not_claim": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      }
    },
    "ip_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_basis", "excluded"],
      "properties": {
        "public_basis": {
          "type": "string",
          "minLength": 1
        },
        "excluded": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      }
    }
  },
  "$defs": {
    "systemId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "systemIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/systemId"
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "stability", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "stability": {
          "enum": ["draft", "experimental", "stable", "deprecated"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
