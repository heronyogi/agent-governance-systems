{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heronyogi/agent-governance-systems/blob/main/trials/FET-001/schemas/protocol.v0.1.schema.json",
  "title": "FET-001 protocol v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trial_id",
    "trial_version",
    "state",
    "proposition",
    "baseline",
    "systems",
    "canonicalization",
    "processing_order",
    "rules",
    "federated_route_dispositions",
    "authority_dispositions",
    "required_case_families",
    "required_mutation_families",
    "reported_dimensions",
    "hard_pass_conditions",
    "aggregate_score_permitted",
    "implementation_gate",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "trial_id": {"const": "FET-001"},
    "trial_version": {"const": "0.1.0"},
    "state": {"const": "review-frozen"},
    "proposition": {"const": "Supported context does not transfer authority."},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "repositories"],
      "properties": {
        "tag": {"const": "federation-adoption-v0.1.0"},
        "repositories": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url", "commit"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "url": {"type": "string", "pattern": "^https://github\\.com/"},
              "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
            }
          }
        }
      }
    },
    "systems": {"type": "object", "required": ["producer", "consumer"]},
    "canonicalization": {"type": "object", "minProperties": 1},
    "processing_order": {
      "const": [
        "SCHEMA",
        "INTEGRITY",
        "FRESHNESS",
        "SCOPE",
        "CONTEXT",
        "AUTHORITY",
        "EFFECT",
        "RECEIPT"
      ]
    },
    "rules": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "requirement"],
        "properties": {
          "id": {"type": "string", "pattern": "^FET-R(?:0[1-9]|1[0-2])$"},
          "name": {"type": "string", "minLength": 1},
          "requirement": {"type": "string", "minLength": 1}
        }
      }
    },
    "federated_route_dispositions": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "authority_dispositions": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "required_case_families": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "required_mutation_families": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "reported_dimensions": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "hard_pass_conditions": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "aggregate_score_permitted": {"const": false},
    "implementation_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "opens_when"],
      "properties": {
        "state": {"const": "closed"},
        "opens_when": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims", "does_not_claim"],
      "properties": {
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "does_not_claim": {
          "type": "array",
          "minItems": 5,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
